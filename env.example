# Local development only. Copy to .env with `make env`; never use these values in cloud environments.
DJANGO_SECRET_KEY=django-insecure-dev-only-change-me
STAGING_DJANGO_SECRET_KEY=django-insecure-staging-local-only-change-me

# PostgreSQL app databases/roles; staging may optionally use STAGING_DATABASE_URL instead.
DB_NAME=django_dev
DB_USER=django_dev
DB_PASSWORD=dev-local-only-change-me
DB_HOST=127.0.0.1
DB_PORT=5432
STAGING_DB_NAME=django_staging
STAGING_DB_USER=django_staging
STAGING_DB_PASSWORD=staging-local-only-change-me
STAGING_DATABASE_URL=
POSTGRES_ADMIN_PASSWORD=postgres-local-only-change-me

# Local Django host/origin allowlists.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
STAGING_ALLOWED_HOSTS=localhost,127.0.0.1
STAGING_CSRF_TRUSTED_ORIGINS=http://localhost:8080
